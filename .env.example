# ===================================================================
# SehatAI -- ONE environment file for the whole stack.
#
#   cp .env.example .env     then fill in the values below.
#
# docker-compose.yml loads this file into every service. For local,
# non-Docker runs each service also finds it (python-dotenv / dotenv walk
# up to the repo root). NEVER commit the real .env -- it is gitignored.
# ===================================================================

# ---------------------------------------------------------- Database
# Supabase project (Postgres + Storage) shared by every service.
SUPABASE_URL=https://your-project.supabase.co
# service_role / sb_secret_ key. Both names are read by different services.
SUPABASE_SERVICE_KEY=sb_secret_your_service_role_key
SUPABASE_KEY=sb_secret_your_service_role_key

# Core API's direct Postgres connection: Supabase -> Settings -> Database
# -> Connection string -> URI (Session pooler, port 5432). URL-encode any
# special characters in the password (@ -> %40, # -> %23).
DATABASE_URL=postgresql+psycopg2://postgres.your-project:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# -------------------------------------------------------- Core API auth
# Random, >= 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
# production refuses to start with a missing/weak SECRET_KEY.
APP_ENV=production

# ------------------------------------------------------ AI providers
# Tried in order with automatic failover; any provider without a key is
# skipped. At least one is required.
AI_PROVIDER_ORDER=aionlabs,gemini,groq,nvidia
AI_PROVIDER_TIMEOUT_MS=90000
AIONLABS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_API_KEY_SEC=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=
REQUESTY_API_KEY=
DEEPSEEK_API_KEY=

# --------------------------------------- OCR / embeddings / medical data
OCRSPACE_API_KEY=
JINA_API_KEY=
INFERMEDICA_APP_ID=
INFERMEDICA_APP_KEY=
USDA_API_KEY=
MEDDATA_API_KEY=
RXCHECK_API_KEY=

# ------------------------------------------- Clinical Evidence (doctors)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Comma-separated keys are failed over in order.
LLM_API_KEYS=nvapi-key-1,nvapi-key-2
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Reasoning ("thinking") off for every stage except claim verification:
# ~3x faster per call with equally valid JSON (measured live).
LLM_ENABLE_THINKING=false
# Parallel LLM calls for paper grading and claim verification.
LLM_CONCURRENCY=4
# NCBI asks every E-utilities caller to identify itself.
NCBI_TOOL_NAME=sehatai
NCBI_EMAIL=you@example.com
# NCBI_API_KEY=

# ------------------------------------------------- Service-to-service
# Shared secret sehatai-backend sends to the internal DietBot service.
DIETBOT_INTERNAL_TOKEN=replace-with-another-random-string
# Local (non-Docker) runs only -- docker-compose overrides this.
DIETBOT_API_URL=http://127.0.0.1:8001

# ---------------------------------------------------------- Features
ENABLE_AI_SAFETY=true
ENABLE_PERSONALIZATION=true
# Dev-only escape hatch for the standalone chat page. Never true in prod.
SEHATAI_ALLOW_UNAUTHENTICATED=false
# Logs raw OCR/LLM output (contains PHI) -- debugging only.
LOG_RAW_OUTPUT=false

# ------------------------------------------------------------ Optional
# Host port the gateway listens on (docker compose).
# SEHAT_PORT=8080
# LOG_LEVEL=INFO
# SIGNUP_RATE_LIMIT_PER_HOUR=20
# LOGIN_RATE_LIMIT_PER_5_MIN=10
