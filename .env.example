# ------------------------------------------------------------
# Medical Document Extraction Pipeline – Environment Variables
# ------------------------------------------------------------
# Copy this file to .env and fill in your actual API keys.

# OCR.space API (free tier ~25k requests/month, 1MB file limit)
OCRSPACE_API_KEY=your_ocrspace_api_key_here

# Google Gemini 3.5 Flash (Batch API only – asynchronous OCR)
# Free tier: ~1,500 requests/day
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (text classification + structuring – synchronous)
GROQ_API_KEY=your_groq_api_key_here

# Jina AI (embeddings – synchronous)
JINA_API_KEY=your_jina_api_key_here

# Supabase (PostgreSQL + pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key_here   # Use service_role, not anon

# Pipeline Configuration
# Set to 'true' to log raw LLM/OCR outputs (PHI risk – only for debugging)
LOG_RAW_OUTPUT=false

# Batch OCR polling interval (seconds)
BATCH_POLL_INTERVAL=10

# Maximum batch size for Gemini (default: 50,000, but we'll use 50 for safety)
BATCH_MAX_SIZE=50