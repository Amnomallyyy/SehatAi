.env
.env.*
!.env.example

# Python venvs -- reproducible from each project's requirements.txt,
# not source. backend/ has its own .gitignore already covering its venv;
# these cover the two added when wiring DataFetch/EvidenceBoard in.
venv/
datafetch_venv/
__pycache__/
*.pyc

# EvidenceBoard's local SQLite cache -- real question history, never committed.
sehatEvidence/evidenceboard.db

# Node dependencies -- reproducible from package-lock.json (`npm ci`).
node_modules/

# Playwright output
sehatEvidence/web/test-results/
sehatEvidence/web/playwright-report/

# Local QA account credentials (generated)
qa-accounts.local.txt
