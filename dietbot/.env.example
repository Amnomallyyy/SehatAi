# DietBot – Environment Variables

# Supabase (PostgreSQL + pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key_here

# NVIDIA API (LLM)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jina AI (embeddings)
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# External APIs (all free tiers)
# HuggingFace – no key needed for public datasets
# MedData – get a free key from https://saferx.online
MEDDATA_API_KEY=your_meddata_key_here

# USDA FoodData Central – get free API key from https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_api_key_here

# TheMealDB – no key required