# EvidenceBoard environment configuration (template).
#
# Copy this file to `.env` (untracked local config -- never committed):
#     cp .env.example .env
# then edit the values. NEVER commit real keys: `.env` stays out of version
# control; this template documents every supported variable with placeholders.
#
# Shell-exported variables take precedence over `.env` values, so you can
# also just export these from your shell instead of using a `.env` file.

# --- PubMed / NCBI E-utilities ---------------------------------------------------

# Required for PubMed. Identifies your app to NCBI, e.g. "evidenceboard".
NCBI_TOOL_NAME=evidenceboard

# Required for PubMed. Contact email NCBI can reach you at.
NCBI_EMAIL=you@example.com

# Optional. Raises the PubMed rate limit from 3 to 10 requests/second.
# NCBI_API_KEY=REPLACE_WITH_YOUR_NCBI_API_KEY

# --- LLM backend (NVIDIA NIM primary, local Ollama fallback) ----------------------

# OpenAI-compatible endpoint. Default: NVIDIA NIM free tier.
# Local Ollama fallback: http://localhost:11434/v1
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Single LLM API key (simple setup).
LLM_API_KEY=nvapi-REPLACE_WITH_YOUR_KEY_1

# Comma-separated keys for automatic failover across multiple free NIM
# accounts. Takes precedence over LLM_API_KEY when both are set.
# LLM_API_KEYS=nvapi-REPLACE_WITH_YOUR_KEY_1,nvapi-REPLACE_WITH_YOUR_KEY_2,nvapi-REPLACE_WITH_YOUR_KEY_3

# Model name exactly as the endpoint expects it.
# NIM default: meta/llama-3.3-70b-instruct; Ollama example: qwen2.5:7b-instruct.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional heavier model for sensitive tasks (entailment/NLI judgment).
# When set, the Verifier uses this for maximum accuracy; other agents use LLM_MODEL.
# LLM_SENSITIVE_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# LLM request timeout in seconds.
LLM_TIMEOUT=60

# --- Pipeline / server ------------------------------------------------------------

# Maximum records kept in the evidence pool after appraisal.
POOL_CAP=30

# Enable supersession checks (newer evidence overrides older answers).
ENABLE_SUPERSESSION=true

# API server bind address and port (local-only by default).
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
